PORT=3001
DATABASE_PATH=./data/ielts.sqlite
# Optional: OpenAI-compatible provider. Never put credentials in the frontend.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Set behind an HTTPS reverse proxy in production:
COOKIE_SECURE=false
TRUST_PROXY=false
# Recommended before public deployment: invitation code for the two learners.
REGISTRATION_CODE=
